<Window x:Class="Div_Ggraphics_Extender.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Div_Ggraphics_Extender"
        mc:Ignorable="d"
        Title="DGE" Height="487" Width="696" MinHeight="460" MinWidth="600">
    <Grid Background="#FFBBBBBB">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="TB_Path" Margin="10,10,152,0" TextWrapping="Wrap" Text="C:\Divine Divinity\static\imagelists\\CPackedi.0c" VerticalAlignment="Top" Height="20"/>
        <Border BorderBrush="Black" BorderThickness="1" Margin="431,40,9,175" >
            <Image x:Name="MyImage"/>
        </Border>
        <ListBox x:Name="LB_Headers" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,35,0,10" FontFamily="Consolas" SelectionChanged="LB_Headers_SelectionChanged" HorizontalAlignment="Left" Width="416"/>
        <Button Content="Open" ToolTip="Open archive (CPackedi.0c, CPackedi.1c, etc. files)" Margin="0,10,81,0" VerticalAlignment="Top" Click="B_OpenFile" HorizontalAlignment="Right" Width="66"/>
        <Button x:Name="B_SavePNG" Content="Save as PNG" ToolTip="Save range of images" Margin="433,0,0,121" VerticalAlignment="Bottom" IsCancel="True" Click="B_SaveAsPNG" HorizontalAlignment="Left" Width="124" IsEnabled="False"/>
        <Button x:Name="B_SaveAllPNG" Content="Save all as PNG" ToolTip="Save all images" Margin="433,0,0,95" VerticalAlignment="Bottom" Click="B_SaveAllAsPNG" HorizontalAlignment="Left" Width="124" IsEnabled="False"/>
        <Button x:Name="B_SaveSprite" Content="Save PNG to Sprite" ToolTip="Convert images into a game archive" Margin="433,0,0,68" VerticalAlignment="Bottom" Click="B_SavePNGToSprite" HorizontalAlignment="Left" Width="124" IsEnabled="False"/>
        <CheckBox x:Name="CB_MaxCompress" ToolTip="Significantly increases processing time, but reduces archive size" Content="Max compression" Margin="433,0,0,48" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="124"/>
        <TextBox x:Name="TB_MinIndex" Margin="433,0,0,147" TextWrapping="Wrap" Text="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="54"/>
        <TextBox x:Name="TB_MaxIndex" Margin="503,0,0,147" TextWrapping="Wrap" Text="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="54"/>
        <Label Content="-" Height="28" Margin="487,0,0,142" VerticalAlignment="Bottom" RenderTransformOrigin="0.233,0.519" HorizontalAlignment="Left" Width="16"/>
        <Button Content="Help" ToolTip="Open archive (CPackedi.0c, CPackedi.1c, etc. files)" Margin="0,10,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="66" Click="B_Help"/>
        <CheckBox x:Name="CB_ReplaceOriginal" ToolTip="Significantly increases processing time, but reduces archive size" Content="Replace original files" Margin="433,0,0,28" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="137"/>
    </Grid>
</Window>
